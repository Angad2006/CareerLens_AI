# Smart Resume Analyzer AI - Backend Environment Variables

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Supabase (optional)
SUPABASE_URL=
SUPABASE_KEY=

# NLP
SPACY_MODEL=en_core_web_sm
